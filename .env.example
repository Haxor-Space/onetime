# ──────────────────────────────────────────────────────────────────────────────
# Onetime Secret – environment configuration
#
# Copy this file to .env, then fill in the values:
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────────────────────

# ── Onetime Secret ────────────────────────────────────────────────────────────
# A long, random secret key used to encrypt stored secrets.
# Generate one with:  openssl rand -hex 32
SECRET_KEY=change-this-to-a-long-random-value

# ── Nginx ─────────────────────────────────────────────────────────────────────
# Local port that nginx listens on (useful for direct access / port-forwarding).
# When using cloudflared the service is reachable through the tunnel and this
# port does not need to be publicly exposed.
NGINX_PORT=8080

# ── Cloudflare Tunnel ─────────────────────────────────────────────────────────
# Token obtained from the Cloudflare Zero Trust dashboard when you create a
# tunnel and choose "Docker" as the connector:
#   https://one.dash.cloudflare.com/
#
# Leave this empty if you are not using cloudflared.
CLOUDFLARE_TUNNEL_TOKEN=
